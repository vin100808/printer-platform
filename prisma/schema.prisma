generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerType {
  internal
  external
}

enum RecordStatus {
  active
  inactive
}

enum PrinterStatus {
  draft
  active
  replaced
  removed
}

enum OrderStatus {
  draft
  confirmed
  completed
  cancelled
}

enum DeviceType {
  black_white
  color
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String         @map("password_hash")
  status       RecordStatus   @default(active)
  sessions     AdminSession[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  adminId   String    @map("admin_id")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model Customer {
  id                         String                      @id @default(cuid())
  customerCode               String                      @unique @map("customer_code")
  customerName               String                      @map("customer_name")
  customerType               CustomerType                @map("customer_type")
  taxpayerIdentificationNo   String?                     @map("taxpayer_identification_no")
  registeredAddress          String?                     @map("registered_address")
  bankName                   String?                     @map("bank_name")
  bankAccountName            String?                     @map("bank_account_name")
  bankAccountNo              String?                     @map("bank_account_no")
  contactName                String?                     @map("contact_name")
  contactPhone               String?                     @map("contact_phone")
  status                     RecordStatus                @default(active)
  remark                     String?
  locations                  Location[]
  customerFrameworkContracts CustomerFrameworkContract[]
  customerPackages           CustomerPackage[]
  customerOrders             CustomerOrder[]
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")

  @@index([customerName])
  @@index([status])
  @@map("customers")
}

model Supplier {
  id                       String                      @id @default(cuid())
  supplierCode             String                      @unique @map("supplier_code")
  supplierName             String                      @map("supplier_name")
  taxpayerIdentificationNo String?                     @map("taxpayer_identification_no")
  registeredAddress        String?                     @map("registered_address")
  bankName                 String?                     @map("bank_name")
  bankAccountName          String?                     @map("bank_account_name")
  bankAccountNo            String?                     @map("bank_account_no")
  contactName              String?                     @map("contact_name")
  contactPhone             String?                     @map("contact_phone")
  serviceArea              String?                     @map("service_area")
  status                   RecordStatus                @default(active)
  remark                   String?
  contracts                SupplierFrameworkContract[]
  supplierPackages         SupplierPackage[]
  supplierOrders           SupplierOrder[]
  createdAt                DateTime                    @default(now()) @map("created_at")
  updatedAt                DateTime                    @updatedAt @map("updated_at")

  @@index([supplierName])
  @@index([status])
  @@map("suppliers")
}

model Location {
  id             String          @id @default(cuid())
  customerId     String          @map("customer_id")
  locationCode   String          @map("location_code")
  locationName   String          @map("location_name")
  address        String
  contactName    String?         @map("contact_name")
  contactPhone   String?         @map("contact_phone")
  status         RecordStatus    @default(active)
  remark         String?
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerOrders CustomerOrder[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@unique([customerId, locationCode])
  @@index([customerId, status])
  @@map("locations")
}

model CustomerFrameworkContract {
  id             String          @id @default(cuid())
  contractNo     String          @map("contract_no")
  contractName   String          @map("contract_name")
  effectiveDate  DateTime        @map("effective_date") @db.Date
  expiryDate     DateTime?       @map("expiry_date") @db.Date
  status         RecordStatus    @default(active)
  attachmentUrl  String?         @map("attachment_url")
  remark         String?
  customers      Customer[]
  customerOrders CustomerOrder[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([contractNo])
  @@index([status])
  @@map("customer_framework_contracts")
}

model SupplierFrameworkContract {
  id             String          @id @default(cuid())
  supplierId     String          @map("supplier_id")
  contractNo     String          @map("contract_no")
  contractName   String          @map("contract_name")
  effectiveDate  DateTime        @map("effective_date") @db.Date
  expiryDate     DateTime?       @map("expiry_date") @db.Date
  status         RecordStatus    @default(active)
  attachmentUrl  String?         @map("attachment_url")
  remark         String?
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierOrders SupplierOrder[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([supplierId])
  @@index([contractNo])
  @@index([status])
  @@map("supplier_framework_contracts")
}

model MachineModel {
  id               String            @id @default(cuid())
  brand            String
  modelName        String            @map("model_name")
  deviceType       DeviceType        @map("device_type")
  status           RecordStatus      @default(active)
  remark           String?
  customerPackages CustomerPackage[]
  supplierPackages SupplierPackage[]
  printers         Printer[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([brand, modelName])
  @@index([status])
  @@map("machine_models")
}

model CustomerPackage {
  id                      String              @id @default(cuid())
  packageCode             String              @map("package_code")
  packageName             String              @map("package_name")
  monthlyRent             Decimal             @map("monthly_rent") @db.Decimal(10, 2)
  monthlyFreeBwEquivalent Decimal             @map("monthly_free_bw_equivalent") @db.Decimal(12, 2)
  overageRateBwEquivalent Decimal             @map("overage_rate_bw_equivalent") @db.Decimal(10, 4)
  customerId              String?             @map("customer_id")
  customer                Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  version                 Int                 @default(1)
  effectiveFrom           DateTime            @map("effective_from") @db.Date
  status                  RecordStatus        @default(active)
  remark                  String?
  machineModels           MachineModel[]
  customerOrderItems      CustomerOrderItem[]
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  @@unique([packageCode, version])
  @@index([customerId])
  @@index([status])
  @@map("customer_packages")
}

model SupplierPackage {
  id                      String              @id @default(cuid())
  packageCode             String              @map("package_code")
  packageName             String              @map("package_name")
  monthlyRent             Decimal             @map("monthly_rent") @db.Decimal(10, 2)
  monthlyFreeBwEquivalent Decimal             @map("monthly_free_bw_equivalent") @db.Decimal(12, 2)
  overageRateBwEquivalent Decimal             @map("overage_rate_bw_equivalent") @db.Decimal(10, 4)
  supplierId              String              @map("supplier_id")
  supplier                Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  version                 Int                 @default(1)
  effectiveFrom           DateTime            @map("effective_from") @db.Date
  status                  RecordStatus        @default(active)
  remark                  String?
  machineModels           MachineModel[]
  supplierOrderItems      SupplierOrderItem[]
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  @@unique([packageCode, version])
  @@index([supplierId])
  @@index([status])
  @@map("supplier_packages")
}

model CustomerOrder {
  id                 String                    @id @default(cuid())
  orderNo            String                    @map("order_no")
  customerId         String                    @map("customer_id")
  locationId         String                    @map("location_id")
  customerContractId String                    @map("customer_contract_id")
  orderDate          DateTime                  @map("order_date") @db.Date
  status             OrderStatus               @default(draft)
  orderAttachmentUrl String?                   @map("order_attachment_url")
  remark             String?
  customer           Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  location           Location                  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  customerContract   CustomerFrameworkContract @relation(fields: [customerContractId], references: [id], onDelete: Restrict)
  items              CustomerOrderItem[]
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  @@unique([orderNo])
  @@index([customerId])
  @@index([status])
  @@map("customer_orders")
}

model CustomerOrderItem {
  id                String          @id @default(cuid())
  customerOrderId   String          @map("customer_order_id")
  customerPackageId String          @map("customer_package_id")
  quantity          Int
  plannedEntryDate  DateTime?       @map("planned_entry_date") @db.Date
  remark            String?
  order             CustomerOrder   @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  customerPackage   CustomerPackage @relation(fields: [customerPackageId], references: [id], onDelete: Restrict)
  printers          Printer[]
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([customerOrderId])
  @@index([customerPackageId])
  @@map("customer_order_items")
}

model SupplierOrder {
  id                 String                    @id @default(cuid())
  orderNo            String                    @map("order_no")
  supplierId         String                    @map("supplier_id")
  supplierContractId String                    @map("supplier_contract_id")
  orderDate          DateTime                  @map("order_date") @db.Date
  status             OrderStatus               @default(draft)
  orderAttachmentUrl String?                   @map("order_attachment_url")
  remark             String?
  supplier           Supplier                  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierContract   SupplierFrameworkContract @relation(fields: [supplierContractId], references: [id], onDelete: Restrict)
  items              SupplierOrderItem[]
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  @@unique([orderNo])
  @@index([supplierId])
  @@index([status])
  @@map("supplier_orders")
}

model SupplierOrderItem {
  id                String          @id @default(cuid())
  supplierOrderId   String          @map("supplier_order_id")
  supplierPackageId String          @map("supplier_package_id")
  quantity          Int
  plannedEntryDate  DateTime?       @map("planned_entry_date") @db.Date
  remark            String?
  order             SupplierOrder   @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  supplierPackage   SupplierPackage @relation(fields: [supplierPackageId], references: [id], onDelete: Restrict)
  printers          Printer[]
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([supplierOrderId])
  @@index([supplierPackageId])
  @@map("supplier_order_items")
}

model Printer {
  id                  String            @id @default(cuid())
  printerCode         String            @unique @map("printer_code")
  supplierAssetCode   String            @map("supplier_asset_code")
  machineModelId      String            @map("machine_model_id")
  customerOrderItemId String            @map("customer_order_item_id")
  supplierOrderItemId String            @map("supplier_order_item_id")
  entryDate           DateTime          @map("entry_date") @db.Date
  exitDate            DateTime?         @map("exit_date") @db.Date
  initialBwReading    Int               @map("initial_bw_reading")
  initialColorReading Int               @map("initial_color_reading")
  status              PrinterStatus     @default(draft)
  previousPrinterId   String?           @unique @map("previous_printer_id")
  qrToken             String            @unique @map("qr_token")
  remark              String?
  machineModel        MachineModel      @relation(fields: [machineModelId], references: [id], onDelete: Restrict)
  customerOrderItem   CustomerOrderItem @relation(fields: [customerOrderItemId], references: [id], onDelete: Restrict)
  supplierOrderItem   SupplierOrderItem @relation(fields: [supplierOrderItemId], references: [id], onDelete: Restrict)
  previousPrinter     Printer?          @relation("PrinterReplacement", fields: [previousPrinterId], references: [id], onDelete: SetNull)
  replacementPrinter  Printer?          @relation("PrinterReplacement")
  meterReadings       MeterReading[]
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@index([machineModelId])
  @@index([customerOrderItemId])
  @@index([supplierOrderItemId])
  @@index([status])
  @@map("printers")
}

model MeterReading {
  id                   String   @id @default(cuid())
  printerId            String   @map("printer_id")
  readingYear          Int      @map("reading_year")
  readingMonth         Int      @map("reading_month")
  previousBwReading    Int      @map("previous_bw_reading")
  currentBwReading     Int      @map("current_bw_reading")
  previousColorReading Int      @map("previous_color_reading")
  currentColorReading  Int      @map("current_color_reading")
  bwUsage              Int      @map("bw_usage")
  colorUsage           Int      @map("color_usage")
  bwEquivalentUsage    Int      @map("bw_equivalent_usage")
  photoUrl             String   @map("photo_url")
  submittedAt          DateTime @default(now()) @map("submitted_at")
  status               String   @default("submitted") @map("status")
  adminNote            String?  @map("admin_note")
  updatedBy            String?  @map("updated_by")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  printer              Printer  @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@unique([printerId, readingYear, readingMonth])
  @@index([printerId])
  @@index([readingYear, readingMonth])
  @@map("meter_readings")
}
